[Unit]
Description=LetoHry Lode FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-/etc/letohry-lode.env
Environment=ROWING_HOST=0.0.0.0
Environment=ROWING_PORT=8000
Environment=ROWING_DIAGNOSTICS_ENABLED=1
ExecStart=__PROJECT_DIR__/.venv/bin/python __PROJECT_DIR__/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target